# Host-side env for compose/docker-compose.agent.yaml.
# Copy to .env next to the compose file. Do not commit.
# Hub URL and secret stay on the host — never bake them into the image or this repo.

TOKEN_MONITOR_HUB_URL=
TOKEN_MONITOR_SECRET=
TOKEN_MONITOR_DEVICE_ID=nas-hermes

# Image already defaults these; listed so a host file can override.
TOKEN_MONITOR_CLIENTS=hermes
TOKEN_MONITOR_LIMITS_ENABLED=0
HERMES_HOME=/opt/data
TOKEN_MONITOR_SHARED_DIR=/var/lib/token-monitor-agent

# Optional: large Hermes state.db, or bind mounts that never fire native events.
TOKEN_MONITOR_TOKSCALE_TIMEOUT_MS=180000
TOKEN_MONITOR_WATCH_POLLING=1
