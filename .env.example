# Host-side env for compose/docker-compose.agent.yaml.
# Copy to .env next to the compose file. Do not commit.
# Hub URL and secret stay on the host — never bake them into the image or this repo.

TOKEN_MONITOR_HUB_URL=
TOKEN_MONITOR_SECRET=
TOKEN_MONITOR_DEVICE_ID=nas-hermes

# Image already defaults these; listed so a host file can override.
TOKEN_MONITOR_CLIENTS=hermes
TOKEN_MONITOR_LIMITS_ENABLED=0
HERMES_HOME=/opt/data
TOKEN_MONITOR_SHARED_DIR=/var/lib/token-monitor-agent

# Periodic collection is the safe default for a remote Hub: one upload every
# five minutes instead of one upload per filesystem event. WATCH_POLLING only
# selects how watches run; it does not rate-limit Hub uploads. It is used only
# if TOKEN_MONITOR_WATCH is changed to 1.
TOKEN_MONITOR_WATCH=0
TOKEN_MONITOR_INTERVAL_MS=300000
TOKEN_MONITOR_WATCH_POLLING=1

# Optional: large Hermes state.db.
TOKEN_MONITOR_TOKSCALE_TIMEOUT_MS=180000

# Outbound HTTP proxy (optional). Node fetch ignores HTTP_PROXY unless the
# flag below is 1 (needs Node >= 22.21, which this image ships). Copy the
# same values the host already uses for other containers. Leave blank if the
# machine can reach the Hub on the default route.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Limits — same probes as the official headless agent; this overlay leaves
# them off. Hermes has no Limits provider (usage only). For static API keys
# in a 24/7 container, set ENABLED=1, allowlist providers, and put those
# keys below. Cookie / CLI / desktop-login providers stay on the widget.
# If a provider is enabled here, turn the same one off on the widget so two
# collectors do not double-probe. Full key list:
# https://github.com/Javis603/token-monitor/blob/main/.env.example
# TOKEN_MONITOR_LIMITS_ENABLED=1
# TOKEN_MONITOR_LIMIT_PROVIDERS=openrouter,deepseek,minimax,volcengine,zai,kimi
# TOKEN_MONITOR_LIMITS_REFRESH_MODE=fixed
# TOKEN_MONITOR_LIMITS_REFRESH_MS=300000
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MINIMAX_CODING_API_KEY=
# VOLCENGINE_ACCESS_KEY_ID=
# VOLCENGINE_SECRET_ACCESS_KEY=
# ZAI_API_KEY=
# KIMI_CODE_API_KEY=
# GROK_BEARER_TOKEN=
# COPILOT_API_TOKEN=
