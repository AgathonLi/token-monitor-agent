# Host-side env for compose/docker-compose.agent.yaml.
# Copy to compose/.env next to the compose file. Do not commit.
# First-deployment template: edit your copy after copying — do not re-copy over
# an already-running deployment's compose/.env.
# Hub URL and secret stay on the host — never bake them into the image or this repo.

TOKEN_MONITOR_HUB_URL=
TOKEN_MONITOR_SECRET=
TOKEN_MONITOR_DEVICE_ID=nas-hermes

# Container timezone: match the Hermes process that writes these logs.
# Log-assisted daily attribution interprets wall-clock log stamps in local time.
# The collector also passes this timezone to Tokscale for periods and daily graphs.
# Defaults to UTC; use e.g. Asia/Shanghai if that is the Hermes logger's timezone.
# Recreate the container after changing TZ. Existing daily history is not automatically rebucketed;
# retain the shared volume when upgrading or changing timezone.
TZ=UTC

# Image defaults. The example gets Compose interpolation from the explicit
# --env-file (a same-named host shell export would take precedence), and the
# service `environment` overrides its `env_file`; either way a value set here
# overrides the image default for that key.
TOKEN_MONITOR_CLIENTS=hermes
TOKEN_MONITOR_LIMITS_ENABLED=0
# Container paths are fixed in compose; changing these alone will not move mounts.
HERMES_HOME=/opt/data
TOKEN_MONITOR_SHARED_DIR=/var/lib/token-monitor-agent

# Session title sync: 0 (default) does NOT upload session titles; usage, cost,
# model and day/month statistics still sync normally — this is not a full
# anonymity switch, it does not affect titles shown locally in Hermes, and it
# is NOT a switch for uploading chat bodies. Titles can expose project or
# customer details, so keep 0. 1 is a sender-side opt-in that additionally
# requires the Hub to support and accept titles, and the display side to
# support them too. If titles were once enabled and are now turned off,
# disabling requests cleanup of the server-side titles: retry on failure while
# keeping the shared state; already-exported copies or backups cannot be
# revoked. After a confirmed OFF negotiation the OFF result is cached by the
# agent negotiator (not the Hub) and reused; an older Hub without capability
# endpoints still syncs usage but may repeat capability GET probes per round.
TOKEN_MONITOR_SYNC_SESSION_TITLES=0

# Periodic collection is the safe default for a remote Hub: one usage upload
# every five minutes instead of one upload per filesystem event. Note that five
# minutes is the usage upload cadence, not a strict ceiling on all HTTP requests
# (e.g. initial capability checks or retries). WATCH_POLLING only selects how
# watches run; it does not rate-limit Hub uploads. It is used only if
# TOKEN_MONITOR_WATCH is changed to 1.
TOKEN_MONITOR_WATCH=0
TOKEN_MONITOR_INTERVAL_MS=300000
TOKEN_MONITOR_WATCH_POLLING=1

# Optional: large Hermes state.db. The 180000 here is an example value, not a
# universal image default.
TOKEN_MONITOR_TOKSCALE_TIMEOUT_MS=180000

# Outbound HTTP proxy (optional). Node fetch ignores HTTP_PROXY unless the
# flag below is 1 (needs Node >= 22.21, which this image ships). Copy the
# same values the host already uses for other containers. Leave blank if the
# machine can reach the Hub on the default route.
# These are honored by HTTP clients inside the agent container — Hub requests
# among them, and possibly other API traffic — but they do not configure the
# Docker daemon; image pulls go through the daemon's own routing layer.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Limits — same probes as the official headless agent; this overlay leaves
# them off. Hermes has no Limits provider (usage only). For static API keys
# in a 24/7 container, set ENABLED=1, allowlist providers, and put those
# keys below. Cookie / CLI / desktop-login providers stay on the widget.
# If a provider is enabled here, turn the same one off on the widget so two
# collectors do not double-probe. Full key list (upstream main may be ahead of
# the version packaged in your image; follow the docs matching the deployed
# image version):
# https://github.com/Javis603/token-monitor/blob/main/.env.example
# TOKEN_MONITOR_LIMITS_ENABLED=1
# TOKEN_MONITOR_LIMIT_PROVIDERS=openrouter,deepseek,minimax,volcengine,zai,kimi
# TOKEN_MONITOR_LIMITS_REFRESH_MODE=fixed
# TOKEN_MONITOR_LIMITS_REFRESH_MS=300000
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MINIMAX_CODING_API_KEY=
# VOLCENGINE_ACCESS_KEY_ID=
# VOLCENGINE_SECRET_ACCESS_KEY=
# ZAI_API_KEY=
# KIMI_CODE_API_KEY=
# Optional Ollama Cloud API-key mode: add ollama to TOKEN_MONITOR_LIMIT_PROVIDERS.
# Cookie mode stays on the widget. OLLAMA_API_KEY is also accepted.
# TOKEN_MONITOR_OLLAMA_API_KEY=
# GROK_BEARER_TOKEN=
# COPILOT_API_TOKEN=
